# MongoDB Atlas connection string (Mongoose)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=resumecraft
# REQUIRED in production: signs JWT session tokens (>= 32 random chars, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret
# Optional: also refuse to boot outside production when JWT_SECRET is missing
STRICT_JWT_SECRET=false
# REQUIRED in production: signs email OTP / password-reset tokens.
# Use a DIFFERENT value from JWT_SECRET — a shared or default secret would let
# anyone forge a password-reset token and take over accounts.
OTP_SECRET=change-me-to-another-long-random-secret
# API port for the Express server (defaults to 3001)
PORT=3001
# Email (Gmail SMTP) — use an App Password, not your real password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=you@gmail.com
# OpenRouter AI (https://openrouter.ai/keys) — powers AI summary + bullet suggestions
OPENROUTER_API_KEY=
# Model to use (free models cost nothing; "openrouter/free" picks a free model at random)
OPENROUTER_MODEL=openrouter/free
# Optional: per-request timeout in ms (default 30000, capped at 60000)
OPENROUTER_TIMEOUT_MS=30000
# Optional: public site URL, sent to OpenRouter for attribution
APP_URL=https://your-app.vercel.app
